{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src"
  },
  // Los *.test.ts los corre el runner nativo de Node directamente sobre el
  // fuente (`node --test`), no se compilan a dist.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
