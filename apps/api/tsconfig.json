{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"
  },
  // Los *.test.ts los corre el runner nativo de Node sobre el fuente
  // (`pnpm test`), no se compilan a dist.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
